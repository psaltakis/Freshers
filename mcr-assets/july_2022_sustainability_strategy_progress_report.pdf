<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.2-c000 79.1b65a79, 2022/06/13-17:46:14        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
   photoshop:Category="A"
   photoshop:DateCreated="2022-04-22T02:00:11"
   photoshop:City="Cambridge"
   photoshop:Country="UK"
   photoshop:TransmissionReference="pa-new/WEATHER Spring  11422885.JPG"
   photoshop:Headline="Spring weather May 13th 2022"
   photoshop:Credit="PA"
   photoshop:Source="PA Archive">
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Weather</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">66864425</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Spring, weather, May, 13th, 2022##, PA2022, WEATHER, Spring</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">PA Archive/PA Images</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Gardener Danny Lawler in the wildflower meadow which has burst into flower at the University of Cambridge's Jesus College. The meadow was sown using seeds harvested from the wildflower lawn at neighboroughing King's College and features harebells, daisies, poppies and cornflowers to create a mini ecosystem for insects and other invertebrates. Picture date: Friday May 13, 2022.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Joe Giddens</rdf:li>
    </rdf:Seq>
   </dc:creator>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

